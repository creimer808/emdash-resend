{
	"name": "emdash-resend",
	"version": "0.1.0",
	"description": "Resend email provider for EmDash CMS, configured from the admin settings page.",
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts --clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"keywords": ["emdash", "emdash-plugin", "resend", "email"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/creimer808/emdash-resend.git"
	},
	"peerDependencies": {
		"emdash": ">=1.3.0"
	},
	"devDependencies": {
		"emdash": "^1.3.1",
		"tsdown": "^0.23.4",
		"typescript": "^5.9.0",
		"vitest": "^5.0.5"
	}
}
